{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "OpenKNXproducer",
            "type": "shell",
            "command": "~/bin/OpenKNXproducer.exe",
            "args": [
                "create",
                "--Debug",
                "-h",
                "include/knxprod.h",
                "src/SoundModule-Dev"
            ],
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Gen. Dependencies.txt",
            "type": "shell",
            "command": "lib/OGM-Common/scripts/setup/reusable/Build-Dependencies.ps1",
            "args": [
            ],
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "scripts/Build-Release.ps1", 
            "args": [
                "Release"
            ],
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Build-Dev",
            "type": "shell",
            "command": "scripts/Build-Release.ps1",
            "args": [
                "Dev"
            ],
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "OpenKNXproducer Documentation",
            "type": "shell",
            "command": "~/bin/OpenKNXproducer.exe",
            "args": [
                "baggages",
                "--DocFileName",
                "doc/Applikationsbeschreibung-Soundmodul.md",
                "--BaggagesDir",
                "src/Baggages/Help_de",
                "--Prefix",
                "SOM"
            ],
            "problemMatcher": [],
            "group": "test"
        }
    ]
}